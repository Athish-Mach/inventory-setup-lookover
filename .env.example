# Server-only settings. Never expose the Supabase service role key to browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes

# Optional: enables GitHub Actions dispatch for manual scrapes (required on Vercel).
# Locally, without these, the API runs main.py in the background instead.
SCRAPER_GITHUB_REPOSITORY=owner/repository
SCRAPER_GITHUB_TOKEN=replace-with-fine-grained-actions-write-token
SCRAPER_GITHUB_BRANCH=main
SCRAPER_GITHUB_WORKFLOW=cisco-scraper.yml
# SCRAPER_ALLOW_LOCAL=false

# Local demo setup only. The seed script refuses Vercel and production.
DEMO_MODE=false

# Optional for local HTTPS proxy setups. Vercel automatically sets Secure cookies.
# COOKIE_SECURE=true
